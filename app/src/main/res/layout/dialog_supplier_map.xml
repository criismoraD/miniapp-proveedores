<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_paper_card"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Cabecera -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:orientation="vertical">

            <TextView
                style="@style/Pv.Overline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Plano de la red" />

            <TextView
                style="@style/Pv.Display"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Mapa de proveedores" />

            <TextView
                android:id="@+id/tvMapBodegaSubtitle"
                style="@style/Pv.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Tu bodega en: Chiclayo - Moshoqueque (JLO)" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnMapClose"
            style="@style/Widget.Material3.Button.IconButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:contentDescription="Cerrar"
            app:icon="@drawable/ic_close"
            app:iconTint="@color/ink_muted" />
    </RelativeLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="10dp"
        android:background="@color/rule" />

    <!-- Lienzo del mapa -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        app:cardBackgroundColor="@color/paper_deep"
        app:cardCornerRadius="6dp"
        app:cardElevation="0dp"
        app:strokeColor="@color/rule_strong"
        app:strokeWidth="1dp">

        <WebView
            android:id="@+id/wvMap"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </com.google.android.material.card.MaterialCardView>

    <!-- Ficha del proveedor seleccionado -->
    <LinearLayout
        android:id="@+id/layoutSupplierInfoCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_paper_card_active"
        android:orientation="vertical"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvMapSelectedSupplierName"
                style="@style/Pv.Headline"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Distribuidora Moshoqueque Central" />

            <TextView
                android:id="@+id/tvMapSelectedSupplierDistance"
                style="@style/Pv.Overline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_pill_gilt"
                android:paddingStart="8dp"
                android:paddingTop="3dp"
                android:paddingEnd="8dp"
                android:paddingBottom="3dp"
                android:textColor="@color/gilt_dark"
                android:textSize="11sp"
                android:text="0.2 km" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvMapSelectedSupplierDetails"
            style="@style/Pv.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textSize="13sp"
            android:text="Toca un distribuidor en el mapa para ver su flete y tiempo estimado." />
    </LinearLayout>

</LinearLayout>
