<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="10dp"
    android:paddingEnd="20dp"
    android:paddingBottom="24dp">

    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_sheet_handle" />

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:orientation="vertical">

            <TextView
                style="@style/Pv.Overline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Próximamente" />

            <TextView
                style="@style/Pv.Display"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Vista proveedor mayorista" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnWholesalerClose"
            style="@style/Widget.Material3.Button.IconButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:contentDescription="Cerrar"
            app:icon="@drawable/ic_close"
            app:iconTint="@color/ink_muted" />
    </RelativeLayout>

    <!-- Nota de modo actual -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_paper_card_active"
        android:orientation="vertical"
        android:padding="14dp">

        <TextView
            style="@style/Pv.Headline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/gilt_dark"
            android:text="Modo comprador (bodega) activo" />

        <TextView
            style="@style/Pv.Body"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/ink"
            android:text="Estás cotizando, comparando y abasteciendo tu bodega al mejor precio con el flete calculado." />
    </LinearLayout>

    <TextView
        style="@style/Pv.Overline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:text="Lo que incluirá el portal proveedor" />

    <TextView
        style="@style/Pv.Body"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:lineSpacingExtra="3dp"
        android:text="•  Publicar precios mayoristas en sacos, fardos y packs.\n•  Configurar tu almacén en Moshoqueque, Chiclayo, Lambayeque o La Victoria.\n•  Gestionar tarifas de flete y montos de envío gratis.\n•  Recibir y despachar pedidos directamente a tu WhatsApp." />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnContinueAsBuyer"
        style="@style/Widget.Material3.Button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:minHeight="50dp"
        android:text="Continuar comprando para mi bodega"
        android:textColor="@color/paper_on_ink"
        app:backgroundTint="@color/ink"
        app:cornerRadius="12dp" />

</LinearLayout>
