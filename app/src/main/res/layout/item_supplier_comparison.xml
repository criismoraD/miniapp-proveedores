<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardSupplierComparison"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="4dp"
    android:layout_marginBottom="10dp"
    app:cardBackgroundColor="@color/paper_surface"
    app:cardCornerRadius="6dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/rule"
    app:strokeWidth="1dp">

    <LinearLayout
        android:id="@+id/llSupplierCardRoot"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- Nombre, distancia y distintivo -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="top"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvSupplierName"
                    style="@style/Pv.Title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="17sp"
                    android:text="Distribuidora Moshoqueque Central" />

                <TextView
                    android:id="@+id/tvSupplierDistrictAndDistance"
                    style="@style/Pv.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="0.2 km • J.L. Ortiz (Moshoqueque)" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvSupplierBadge"
                style="@style/Pv.Overline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_pill_gilt"
                android:paddingStart="7dp"
                android:paddingTop="3dp"
                android:paddingEnd="7dp"
                android:paddingBottom="3dp"
                android:textColor="@color/gilt_dark"
                android:textSize="10sp"
                android:text="Mejor total" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvOfferNote"
            style="@style/Pv.Body"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Pack x 12 surtidas • Stock disponible" />

        <TextView
            android:id="@+id/tvFreeShippingCondition"
            style="@style/Pv.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="35-50 min • Envío gratis desde S/ 140" />

        <!-- Desglose: producto + flete = costo final -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_card_sheet_block"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="10dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/Pv.Overline"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="10sp"
                    android:text="Producto" />

                <TextView
                    android:id="@+id/tvUnitPrice"
                    style="@style/Pv.Headline"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="sans-serif-medium"
                    android:textSize="14sp"
                    android:text="S/ 23.50" />
            </LinearLayout>

            <TextView
                style="@style/Pv.Body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="+" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/Pv.Overline"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="10sp"
                    android:text="Flete" />

                <TextView
                    android:id="@+id/tvFleteCost"
                    style="@style/Pv.Headline"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="sans-serif-medium"
                    android:textSize="14sp"
                    android:text="S/ 3.60" />
            </LinearLayout>

            <TextView
                style="@style/Pv.Body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="=" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1.2"
                android:orientation="vertical">

                <TextView
                    style="@style/Pv.Overline"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/gilt_dark"
                    android:textSize="10sp"
                    android:text="Costo final" />

                <TextView
                    android:id="@+id/tvFinalTotal"
                    style="@style/Pv.Price"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textSize="19sp"
                    android:text="S/ 27.10" />
            </LinearLayout>
        </LinearLayout>

        <!-- Añadir con este proveedor -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSelectSupplier"
            style="@style/Widget.Material3.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:minHeight="46dp"
            android:text="Añadir al pedido"
            android:textColor="@color/paper_on_ink"
            app:backgroundTint="@color/ink"
            app:cornerRadius="10dp"
            app:icon="@drawable/ic_add"
            app:iconGravity="textStart"
            app:iconTint="@color/paper_on_ink" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
