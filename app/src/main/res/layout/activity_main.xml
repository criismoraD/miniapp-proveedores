<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_paper"
    android:fitsSystemWindows="true">

    <!-- ===== Portada (masthead) + controles fijos ===== -->
    <LinearLayout
        android:id="@+id/llHeaderContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingTop="10dp"
        android:paddingEnd="18dp">

        <!-- Línea de fecha y selector de rol -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/tvMastheadDate"
                style="@style/Pv.Overline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:text="Edición de hoy" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRoleToggle"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:minHeight="36dp"
                android:paddingStart="8dp"
                android:paddingEnd="2dp"
                android:text="Bodega"
                android:textColor="@color/ink"
                android:textSize="13sp"
                app:icon="@drawable/ic_arrow_drop_down"
                app:iconGravity="textEnd"
                app:iconTint="@color/gilt"
                app:iconPadding="0dp" />
        </RelativeLayout>

        <!-- Nombre de la publicación -->
        <TextView
            android:id="@+id/tvBrand"
            style="@style/Pv.Masthead"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:text="ProveeChiclayo" />

        <TextView
            style="@style/Pv.Overline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="center"
            android:text="Red mayorista · Chiclayo y Lambayeque" />

        <!-- Doble filete tipográfico -->
        <View
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:layout_marginTop="10dp"
            android:background="@color/ink" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="3dp"
            android:background="@color/ink" />

        <!-- Ubicación de la bodega + mapa -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/btnLocationPicker"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_field_paper"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingTop="9dp"
                android:paddingEnd="8dp"
                android:paddingBottom="9dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_place"
                    app:tint="@color/gilt" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Pv.Overline"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Mi bodega en" />

                    <TextView
                        android:id="@+id/tvSelectedLocation"
                        style="@style/Pv.Headline"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textSize="15sp"
                        android:text="Chiclayo - Moshoqueque (JLO)" />
                </LinearLayout>

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_arrow_drop_down"
                    app:tint="@color/ink_muted" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnOpenMap"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:minHeight="48dp"
                android:text="Mapa"
                android:textColor="@color/ink"
                app:cornerRadius="10dp"
                app:icon="@drawable/ic_map"
                app:iconTint="@color/ink"
                app:strokeColor="@color/rule_strong" />
        </LinearLayout>

        <!-- Búsqueda: campo de tinta con borde fino -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilSearch"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="Buscar sporade, arroz, aceite, leche…"
            app:boxBackgroundColor="@color/paper_surface"
            app:boxCornerRadiusBottomEnd="12dp"
            app:boxCornerRadiusBottomStart="12dp"
            app:boxCornerRadiusTopEnd="12dp"
            app:boxCornerRadiusTopStart="12dp"
            app:boxStrokeColor="@color/rule_strong"
            app:endIconMode="clear_text"
            app:endIconTint="@color/ink_muted"
            app:hintTextColor="@color/ink_muted"
            app:startIconDrawable="@drawable/ic_search"
            app:startIconTint="@color/ink_muted">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etSearch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:maxLines="1"
                android:textColor="@color/ink"
                android:textSize="15sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Categorías -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:overScrollMode="never"
            android:scrollbars="none">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/cgCategories"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:chipSpacingHorizontal="8dp"
                app:selectionRequired="true"
                app:singleLine="true"
                app:singleSelection="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipCatAll"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="Todos" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipCatDrinks"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Bebidas" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipCatGroceries"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Abarrotes" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipCatSweets"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Golosinas" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipCatCleaning"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Limpieza" />
            </com.google.android.material.chip.ChipGroup>
        </HorizontalScrollView>

        <!-- Criterio de comparación -->
        <TextView
            style="@style/Pv.Overline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Comparar proveedores por" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:overScrollMode="never"
            android:scrollbars="none">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/cgSort"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:chipSpacingHorizontal="8dp"
                app:selectionRequired="true"
                app:singleLine="true"
                app:singleSelection="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipSortConvenient"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="Más conveniente" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipSortPrice"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Menor precio" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipSortDistance"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Más cercano" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipSortDelivery"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Menor flete" />
            </com.google.android.material.chip.ChipGroup>
        </HorizontalScrollView>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="10dp"
            android:background="@color/rule" />
    </LinearLayout>

    <!-- ===== Listado de productos (hojas) ===== -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvProducts"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/llHeaderContainer"
        android:clipToPadding="false"
        android:layoutAnimation="@anim/layout_paper_fall"
        android:overScrollMode="ifContentScrolls"
        android:paddingStart="12dp"
        android:paddingTop="6dp"
        android:paddingEnd="12dp"
        android:paddingBottom="110dp" />

    <!-- ===== Estado vacío ===== -->
    <LinearLayout
        android:id="@+id/llEmptyState"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_inventory"
            app:tint="@color/ink_muted" />

        <TextView
            style="@style/Pv.Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Sin coincidencias" />

        <TextView
            style="@style/Pv.Body"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="Prueba con otro término, como «Sporade», «Arroz» o «Leche», o cambia de categoría." />
    </LinearLayout>

    <!-- ===== Barra de pedido flotante (tinta) ===== -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardCartBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="12dp"
        android:visibility="gone"
        app:cardBackgroundColor="@color/ink"
        app:cardCornerRadius="16dp"
        app:cardElevation="8dp"
        app:strokeWidth="0dp">

        <LinearLayout
            android:id="@+id/layoutCartBarContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_cart_ink"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="18dp"
            android:paddingTop="12dp"
            android:paddingEnd="12dp"
            android:paddingBottom="12dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvCartSummaryCountAndTotal"
                    style="@style/Pv.Title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/paper_on_ink"
                    android:textSize="17sp" />

                <TextView
                    android:id="@+id/tvCartSummarySubtitle"
                    style="@style/Pv.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:textColor="@color/gilt"
                    android:textSize="12sp" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnOpenCart"
                style="@style/Widget.Material3.Button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ver pedido"
                android:textColor="@color/ink"
                app:backgroundTint="@color/paper_surface"
                app:cornerRadius="10dp"
                app:icon="@drawable/ic_arrow_forward"
                app:iconGravity="textEnd"
                app:iconTint="@color/ink" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</RelativeLayout>
