<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- ==========================================================
         Paleta "Papel y Tinta"
         Nombres semánticos: cada color describe su rol, no su tono.
         La variante nocturna está en values-night/colors.xml.
         ========================================================== -->

    <!-- Papel -->
    <color name="paper_bg">#F2ECDF</color>          <!-- Fondo de página -->
    <color name="paper_surface">#FBF8F1</color>     <!-- Tarjetas y hojas -->
    <color name="paper_deep">#E8DFCB</color>        <!-- Superficies hundidas / chips -->
    <color name="paper_on_ink">#F7F2E7</color>      <!-- Texto sobre tinta -->

    <!-- Tinta -->
    <color name="ink">#1E2331</color>               <!-- Texto principal y acciones -->
    <color name="ink_soft">#3F4656</color>          <!-- Texto secundario fuerte -->
    <color name="ink_muted">#6E6755</color>         <!-- Metadatos, etiquetas -->
    <color name="rule">#D3C8B0</color>              <!-- Filetes y bordes finos -->
    <color name="rule_strong">#9C917A</color>       <!-- Bordes de campos y foco -->

    <!-- Dorado de imprenta -->
    <color name="gilt">#A8803B</color>
    <color name="gilt_soft">#F1E6CC</color>
    <color name="gilt_dark">#6B4F17</color>
    <color name="gilt_ripple">#33A8803B</color>

    <!-- Sello de tinta roja (acción confirmada / alerta) -->
    <color name="stamp">#9E3B2B</color>
    <color name="stamp_soft">#F5E2DA</color>

    <!-- Verde musgo (ahorro, envío gratis) -->
    <color name="sage">#3B6A50</color>
    <color name="sage_soft">#E1EADC</color>

    <color name="ripple_ink">#1F1E2331</color>
    <color name="scrim">#801E2331</color>

    <color name="black">#FF000000</color>
    <color name="white">#FFFFFFFF</color>
</resources>
